<ui.column key="login" {h-full items-center justify-center}>
  <ui.form key="login-form" [form]="loginForm" [canSubmit]="loginForm.canSubmit" (submit)="unlock" {flex-y gap-y-4}>
    <ui.text key="title" {text-4xl font-light mb-2}>LogOS</ui.text>
    <ui.input key="username" [control]="loginForm.controls.username" {w-96 font-light focus:bg-accent}/>
    <ui.input key="password" [control]="loginForm.controls.password" {w-96 mt-4 font-light focus:bg-accent}/>
    <ui.button key="submit" [disabled]="!loginForm.canSubmit" {opacity-50}="failure" (submit)="loginForm.submit()" {mt-4 px-6 py-3 rounded-lg bg-accent}>Unlock</ui.button>
  </ui.form>
</ui.column>
