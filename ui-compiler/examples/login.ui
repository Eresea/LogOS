<ui.column key="login" {h-full items-center justify-center}>
  <ui.text key="title" {text-4xl font-light mb-2}>LogOS</ui.text>
  <ui.input key="username" [(value)]="username" {w-96}/>
  <ui.input key="password" [(value)]="password" {w-96 mt-4}/>
  <ui.button key="submit" [disabled]="unlocking" (click)="unlock" {mt-4 px-6 py-3 rounded-lg bg-accent}>Unlock</ui.button>
</ui.column>
